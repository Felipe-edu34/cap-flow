# =============================================================================
# CapFlow — variáveis de ambiente
# Copie para .env (cp .env.example .env) e ajuste. O .env NÃO deve ser commitado.
# =============================================================================

# 'local' = PostgreSQL do docker-compose (sem SSL)
# 'production' = Supabase (DATABASE_URL obrigatória, SSL forçado)
ENVIRONMENT=local

# --- Django -------------------------------------------------------------------
# Obrigatória em produção. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Padrão: True em local, False em produção
DJANGO_DEBUG=
# Lista separada por vírgula. Padrão '*' em local; obrigatória em produção.
DJANGO_ALLOWED_HOSTS=

# --- Supabase Auth (GoTrue JWT) -----------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Banco LOCAL (docker-compose + Django em modo local) ----------------------
# Usadas pelo docker-compose.yml para criar o banco e pelo Django para conectar.
DB_NAME=capflow
DB_USER=capflow
DB_PASSWORD=capflow_dev_password
DB_HOST=localhost
DB_PORT=5432

# --- Banco PRODUÇÃO (Supabase) ------------------------------------------------
# Dashboard do Supabase > botão "Connect". Escolha UMA das opções:
#
# (A) Transaction Pooler — porta 6543. Recomendado para a API rodando em produção
#     (muitas conexões curtas / serverless). Server-side cursors são desativados
#     automaticamente nesta porta.
# DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
#
# (B) Session Pooler — porta 5432, mesmo host do pooler. Conexão persistente e
#     compatível com IPv4. Use para rodar migrations.
# DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
#
# (C) Direct Connection — porta 5432, direto no Postgres. Só IPv6, a menos que o
#     add-on de IPv4 esteja ativo no projeto.
# DATABASE_URL=postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres
#
# Senhas com caracteres especiais (@ : / # ? %) precisam ser URL-encoded.
DATABASE_URL=

# Segundos que o Django reaproveita uma conexão (0 = fecha a cada request).
DB_CONN_MAX_AGE=60
# Força ligar/desligar server-side cursors. Vazio = automático (desliga na porta 6543).
DB_DISABLE_SERVER_SIDE_CURSORS=
